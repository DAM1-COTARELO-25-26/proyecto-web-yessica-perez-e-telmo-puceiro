<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:annotation>
    <xs:documentation>Esquema XSD TELSIC - Validación de Tipos y Restricciones [cite: 70]</xs:documentation>
  </xs:annotation>

  <xs:element name="catalogo">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="producto" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="nombre" type="xs:string"/>
              
              <xs:element name="descripcion">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="500"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>

              <xs:element name="especificaciones">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="material" type="xs:string" maxOccurs="unbounded"/>
                    <xs:element name="dimension" type="xs:string" minOccurs="0"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <xs:element name="precio">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="tipoPrecio">
                      <xs:attribute name="moneda" type="xs:string" use="required"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>

              <xs:element name="fechaRegistro" type="xs:date"/>
              <xs:element name="disponible" type="xs:boolean"/>
            </xs:sequence>

            <xs:attribute name="id" type="tipoId" use="required"/>
            <xs:attribute name="categoria" type="tipoCategoria" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:simpleType name="tipoId">
    <xs:restriction base="xs:string">
      <xs:pattern value="[RPA][0-9]{3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tipoPrecio">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:fractionDigits value="2"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tipoCategoria">
    <xs:restriction base="xs:string">
      <xs:enumeration value="relojes"/>
      <xs:enumeration value="pulseras"/>
      <xs:enumeration value="anillos"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>